<section class="tab {{tab.cssClass}}" data-group="primary" data-tab="{{tab.id}}">
    <fieldset>
        <legend>Blood Gift Details</legend>
        
        <div class="form-group">
            <label class="label-text">Bloodline</label>
            <div class="input-box">
                <input class="input-text" type="text" name="system.bloodline" value="{{system.bloodline}}" placeholder="e.g. Von Carstein, Universal" />
            </div>
        </div>
    </fieldset>
</section>